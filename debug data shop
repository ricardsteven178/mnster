local typeColors = {
    TOOL = Color3.fromRGB(80, 160, 255),
    UPGRADE = Color3.fromRGB(255, 180, 50),
    CURRENCY = Color3.fromRGB(200, 100, 255),
}

local function rebuildList()
    for _, child in ipairs(scrollFrame:GetChildren()) do
        if child:IsA("Frame") then child:Destroy() end
    end

    local list = {}
    for _, e in pairs(discovered) do table.insert(list, e) end
    table.sort(list, function(a, b)
        if a.type ~= b.type then return a.type < b.type end
        return a.cost < b.cost
    end)

    for i, e in ipairs(list) do
        local row = Instance.new("Frame")
        row.Size = UDim2.new(1, -8, 0, 28)
        row.BackgroundColor3 = i % 2 == 0 and Color3.fromRGB(28, 28, 38) or Color3.fromRGB(22, 22, 30)
        row.BorderSizePixel = 0
        row.LayoutOrder = i
        row.Parent = scrollFrame
        Instance.new("UICorner", row).CornerRadius = UDim.new(0, 4)

        -- Type badge
        local badge = Instance.new("TextLabel")
        badge.Size = UDim2.new(0, 70, 1, -6)
        badge.Position = UDim2.new(0, 2, 0, 3)
        badge.BackgroundColor3 = typeColors[e.type] or Color3.fromRGB(100, 100, 100)
        badge.BackgroundTransparency = 0.7
        badge.TextColor3 = typeColors[e.type] or Color3.fromRGB(200, 200, 200)
        badge.Font = Enum.Font.GothamBold
        badge.TextSize = 9
        badge.Text = e.type
        badge.Parent = row
        Instance.new("UICorner", badge).CornerRadius = UDim.new(0, 3)

        -- Name
        local nameLabel = Instance.new("TextLabel")
        nameLabel.Size = UDim2.new(1, -155, 1, 0)
        nameLabel.Position = UDim2.new(0, 78, 0, 0)
        nameLabel.BackgroundTransparency = 1
        nameLabel.TextColor3 = Color3.fromRGB(220, 220, 220)
        nameLabel.Font = Enum.Font.Gotham
        nameLabel.TextSize = 11
        nameLabel.TextXAlignment = Enum.TextXAlignment.Left
        nameLabel.TextTruncate = Enum.TextTruncate.AtEnd
        nameLabel.TextScaled = true
        nameLabel.Text = e.name
        nameLabel.Parent = row

        -- Cost
        local costLabel = Instance.new("TextLabel")
        costLabel.Size = UDim2.new(0, 65, 1, 0)
        costLabel.Position = UDim2.new(1, -68, 0, 0)
        costLabel.BackgroundTransparency = 1
        costLabel.TextColor3 = Color3.fromRGB(80, 220, 120)
        costLabel.Font = Enum.Font.GothamBold
        costLabel.TextSize = 12
        costLabel.Text = e.cost
        costLabel.Parent = row
    end

    scrollFrame.CanvasSize = UDim2.new(0, 0, 0, #list * 30 + 10)

    -- Update progress
    local total = #list
    local pct = math.clamp(total / TARGET_TOTAL, 0, 1)
    progressFill.Size = UDim2.new(pct, 0, 1, 0)
    progressLabel.Text = total .. " / " .. TARGET_TOTAL

    if total >= TARGET_TOTAL then
        progressFill.BackgroundColor3 = Color3.fromRGB(80, 200, 120)
        statusLabel.TextColor3 = Color3.fromRGB(80, 220, 120)
        statusLabel.Text = "✅ COMPLETE — siap di-copy!"
        btnCopy.BackgroundColor3 = Color3.fromRGB(40, 220, 100)
    else
        progressFill.BackgroundColor3 = Color3.fromRGB(80, 150, 220)
        statusLabel.TextColor3 = Color3.fromRGB(150, 150, 170)
        statusLabel.Text = "⏳ Scanning... kurang " .. (TARGET_TOTAL - total) .. " item lagi"
    end
end

-- ══════════════════════════════════════
-- SCAN LOGIC
-- ══════════════════════════════════════
local function scanCurrentSlots()
    local newFound = 0
    for _, pp in ipairs(CollectionService:GetTagged("ShopItemPP")) do
        pcall(function()
            local itemModel = pp.Parent
            if not itemModel then return end

            local entry = { modelName = itemModel.Name, type="?", cost="?", name="?", soldOut = itemModel:FindFirstChild("SoldOut") ~= nil }

            for _, label in ipairs(itemModel:GetDescendants()) do
                if label:IsA("TextLabel") and label.Text and #label.Text > 0 then
                    local n = label.Name:lower()
                    if n == "type" then
                        entry.type = label.Text:gsub("%[",""):gsub("%]",""):match("^%s*(.-)%s*$")
                    elseif n == "cost" then
                        entry.cost = label.Text
                    elseif n == "description" then
                        entry.name = label.Text
                    end
                end
            end

            local key = entry.name .. "_" .. entry.cost
            if not discovered[key] and entry.name ~= "?" then
                discovered[key] = entry
                newFound = newFound + 1
            end
        end)
    end

    if newFound > 0 then
        rebuildList()
    end
end

