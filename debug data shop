btnCopy.MouseButton1Click:Connect(function()
    local list = {}
    for _, e in pairs(discovered) do table.insert(list, e) end
    table.sort(list, function(a, b)
        if a.type ~= b.type then return a.type < b.type end
        return a.cost < b.cost
    end)

    local lines = {}
    table.insert(lines, "-- AXIOM SHOP DATABASE")
    table.insert(lines, "-- Total: " .. #list .. " items")
    table.insert(lines, "local ShopDatabase = {")
    for _, e in ipairs(list) do
        local costStr = e.cost:gsub("%$",""):gsub(",","")
        local costNum = tonumber(costStr) or 0
        table.insert(lines, string.format(
            '    { modelName="%s", type="%s", cost=%d, name="%s" },',
            e.modelName, e.type, costNum, e.name:gsub('"', '\\"')
        ))
    end
    table.insert(lines, "}")
    table.insert(lines, "return ShopDatabase")

    local output = table.concat(lines, "\n")

    -- Copy ke clipboard
    if setclipboard then
        setclipboard(output)
        btnCopy.Text = "✅ COPIED!"
        btnCopy.BackgroundColor3 = Color3.fromRGB(40, 160, 80)
        task.delay(2, function()
            btnCopy.Text = "📋 COPY DATABASE"
            btnCopy.BackgroundColor3 = Color3.fromRGB(60, 180, 100)
        end)
    else
        -- Fallback: print ke console
        warn("[AXIOM] setclipboard tidak support — output di console:")
        print(output)
        btnCopy.Text = "📄 CEK CONSOLE"
        task.delay(2, function() btnCopy.Text = "📋 COPY DATABASE" end)
    end
end)

