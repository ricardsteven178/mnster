	if not LOG_ENABLED["SYS"] then return end
	if filterText ~= "" and not string.find(string.lower(msg), string.lower(filterText)) then return end

	logCount += 1
	local entry = string.format("%d - %s [HL] %s", logCount, getTimestamp(), msg)
	table.insert(logs, entry)

	if #logs > MAX_LOGS then
		table.remove(logs, 1)
		for _, c in ipairs(ScrollFrame:GetChildren()) do
			if c:IsA("TextLabel") then c:Destroy() break end
		end
	end

	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, -8, 0, 16)
	label.BackgroundTransparency = 1
	label.Text = entry
	label.TextColor3 = Color3.fromRGB(180, 100, 255)
	label.Font = Enum.Font.Code
	label.TextSize = 10
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.TextTruncate = Enum.TextTruncate.AtEnd
	label.LayoutOrder = logCount
	label.Parent = ScrollFrame
	local pad = Instance.new("UIPadding", label)
	pad.PaddingLeft = UDim.new(0, 4)

	task.defer(function()
		ScrollFrame.CanvasPosition = Vector2.new(0, math.huge)
	end)

	StatusBar.Text = "logs: " .. logCount .. " | status: " .. (isPaused and "⏸ PAUSED" or "🔴 LIVE")
end

local stepStates = {}

local STEP_PARENT_NAMES = {
	"Form",
	"Camera", 
	"Computer",
	"Printer",
	"PrintedBadge",
}

task.spawn(function()
	-- Tunggu Misc dulu
	local misc = workspace:WaitForChild("Misc", 10)
	if not misc then
		addLog("SYS", "⚠️ Misc tidak ditemukan")
		return
	end

	local checkIn = misc:WaitForChild("CheckIn", 10)
	if not checkIn then
		addLog("SYS", "⚠️ CheckIn tidak ditemukan")
		return
	end

	addLog("SYS", "CheckStep watcher v6 ONLINE — polling CheckIn + NPCs")

	while _G.AxiomDebugger_ExecutionID == ExecutionID do
		task.wait(0.05)

		-- Poll step 1-5 langsung dari CheckIn
		for _, name in ipairs(STEP_PARENT_NAMES) do
			local ok, parent = pcall(function()
				return checkIn:FindFirstChild(name)
			end)
			if ok and parent then
				local ok2, hl = pcall(function()
					return parent:FindFirstChild("CheckStepHighlight", true)
				end)
				if not ok2 then hl = nil end

				local label = "Step_" .. name
				local prev = stepStates[label]
				local curr = (hl ~= nil)

				if curr ~= prev then
					stepStates[label] = curr
					if curr then
						addHighlightLog(string.format("STEP ACTIVE | %s | %s", label, hl:GetFullName()))
					else
						addHighlightLog(string.format("STEP DONE | %s", label))
					end
				end
			end
		end

		-- Poll step 6 — NPC folder
		local ok3, npcs = pcall(function()
			return workspace:FindFirstChild("NPCs")
		end)
		if ok3 and npcs then
			for _, npc in ipairs(npcs:GetChildren()) do
				if npc:IsA("Model") then
					local npcLabel = "Step6_" .. npc.Name
					local ok4, hl = pcall(function()
						return npc:FindFirstChild("CheckStepHighlight", true)
					end)
					if not ok4 then hl = nil end

					local prev = stepStates[npcLabel]
					local curr = (hl ~= nil)

					if curr ~= prev then
						stepStates[npcLabel] = curr
						if curr then
							addHighlightLog(string.format("STEP ACTIVE | %s | %s", npcLabel, hl:GetFullName()))
						else
							addHighlightLog(string.format("STEP DONE | %s", npcLabel))
						end
					end
				end
			end
		end
	end
end)
