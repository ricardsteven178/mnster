-- ==========================================
-- PROXIMITY PROMPT HOOKING
-- ==========================================
local function hookPP(pp)
	if not pp:IsA("ProximityPrompt") then return end
	pp.Triggered:Connect(function()
		local now = tick()
		local key = tostring(pp)
		if ppCooldowns[key] and now < ppCooldowns[key] then return end
		ppCooldowns[key] = now + COOLDOWN_PP

		local cur = pp.Parent
		local parts = {}
		while cur and cur ~= workspace do
			table.insert(parts, 1, cur.Name)
			cur = cur.Parent
		end
		local path = table.concat(parts, ".") .. "." .. pp.Name

		-- Skip blacklisted paths
		if PP_BLACKLIST[path] then return end

		local msg = string.format("Action='%s' | Path='%s'", pp.ActionText or "?", path)
		addLog("PP", msg)
	end)
end

