-- ==========================================
-- LOG SYSTEM
-- ==========================================
local logCount = 0

local function getTimestamp()
	local t = os.date("*t")
	return string.format("[%02d:%02d:%02d]", t.hour, t.min, t.sec)
end

local function getColor(category)
	if category == "RE" then return Color3.fromRGB(0, 200, 255)
	elseif category == "PP" then return Color3.fromRGB(255, 200, 0)
	elseif category == "SYS" then return Color3.fromRGB(100, 255, 100)
	else return Color3.fromRGB(200, 200, 200) end
end

local function addLog(category, message)
	if isPaused then return end
	if not LOG_ENABLED[category] then return end
	if filterText ~= "" and not string.find(string.lower(message), string.lower(filterText)) then return end

	logCount += 1
	local entry = string.format("%d - %s [%s] %s", logCount, getTimestamp(), category, message)

	table.insert(logs, entry)

	if #logs > MAX_LOGS then
		table.remove(logs, 1)
		local children = ScrollFrame:GetChildren()
		for _, c in ipairs(children) do
			if c:IsA("TextLabel") then
				c:Destroy()
				break
			end
		end
	end

	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, -8, 0, 16)
	label.BackgroundTransparency = 1
	label.Text = entry
	label.TextColor3 = getColor(category)
	label.Font = Enum.Font.Code
	label.TextSize = 10
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.TextTruncate = Enum.TextTruncate.AtEnd
	label.LayoutOrder = logCount
	label.Parent = ScrollFrame
	local pad = Instance.new("UIPadding", label)
	pad.PaddingLeft = UDim.new(0, 4)

	task.defer(function()
		ScrollFrame.CanvasPosition = Vector2.new(0, math.huge)
	end)

	StatusBar.Text = "logs: " .. logCount .. " | status: " .. (isPaused and "⏸ PAUSED" or "🔴 LIVE")
end

-- ==========================================
-- REMOTE EVENT HOOKING
-- ==========================================
local function hookRemotes(folder)
	if not folder then return end
	for _, re in ipairs(folder:GetChildren()) do
		if re:IsA("RemoteEvent") and string.match(re.Name, "^RE/") then
			local reName = re.Name
			re.OnClientEvent:Connect(function(...)
				local now = tick()
				local key = reName
				if RE_BLACKLIST[reName] then return end
				if reCooldowns[key] and now < reCooldowns[key] then return end
				reCooldowns[key] = now + COOLDOWN_RE

				local args = {...}
				local parts = {}
				for _, v in ipairs(args) do
					local t = typeof(v)
					if t == "Instance" then
						table.insert(parts, "[Instance] " .. v.Name)
					elseif t == "Vector3" then
						table.insert(parts, string.format("[Vector3] %.1f, %.1f, %.1f", v.X, v.Y, v.Z))
					elseif t == "string" then
						table.insert(parts, "[string] " .. v)
					elseif t == "number" then
						table.insert(parts, "[number] " .. tostring(v))
					elseif t == "boolean" then
						table.insert(parts, "[boolean] " .. tostring(v))
					else
						table.insert(parts, "[" .. t .. "]")
					end
				end

				local msg = reName .. " | " .. table.concat(parts, " | ")
				addLog("RE", msg)
			end)
		end
	end
end

