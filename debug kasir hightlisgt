-- ==========================================
-- NPC / TASK VALUE WATCHER
-- ==========================================
local watchedInstances = {}

local function watchValues(root, label)
	for _, obj in ipairs(root:GetDescendants()) do
		if obj:IsA("ValueBase") and not watchedInstances[obj] then
			watchedInstances[obj] = true
			obj:GetPropertyChangedSignal("Value"):Connect(function()
				if _G.AxiomDebugger_ExecutionID ~= ExecutionID then return end
				addLog("SYS", string.format("ValueChange | %s.%s = '%s'", label, obj:GetFullName():gsub(tostring(root) .. ".", ""), tostring(obj.Value)))
			end)
		end
	end
	root.DescendantAdded:Connect(function(obj)
		if obj:IsA("ValueBase") and not watchedInstances[obj] then
			watchedInstances[obj] = true
			obj:GetPropertyChangedSignal("Value"):Connect(function()
				if _G.AxiomDebugger_ExecutionID ~= ExecutionID then return end
				addLog("SYS", string.format("ValueChange | %s.%s = '%s'", label, obj:GetFullName():gsub(tostring(root) .. ".", ""), tostring(obj.Value)))
			end)
		end
	end)
end

-- Scan semua player data (skip PlayerGui — terlalu noisy)
local function watchValues_Player(plr)
	local targets = {"leaderstats", "Data", "PlayerData", "Stats"}
	for _, folderName in ipairs(targets) do
		local folder = plr:FindFirstChild(folderName)
		if folder then watchValues(folder, "Player:" .. plr.Name) end
	end
	plr.ChildAdded:Connect(function(child)
		for _, folderName in ipairs(targets) do
			if child.Name == folderName then
				watchValues(child, "Player:" .. plr.Name)
			end
		end
	end)
end

for _, plr in ipairs(Players:GetPlayers()) do
	watchValues_Player(plr)
end
Players.PlayerAdded:Connect(function(plr)
	watchValues_Player(plr)
end)

