		local strangePaper = workspace:FindFirstChild("Misc")
			and workspace.Misc:FindFirstChild("StrangePaper")
			and workspace.Misc.StrangePaper:FindFirstChild("PP")
		if isReady(strangePaper) then return strangePaper, "inspect (stalker)" end

		local stalkerCamPP = workspace:FindFirstChild("Misc")
			and workspace.Misc:FindFirstChild("CheckIn")
			and workspace.Misc.CheckIn:FindFirstChild("Camera")
			and workspace.Misc.CheckIn.Camera:FindFirstChild("StalkerPP")
		if isReady(stalkerCamPP) then return stalkerCamPP, "take photo (stalker)" end
	end

	-- Hazmat NPC di Radar1/Radar2
	local npcsFolder = workspace:FindFirstChild("NPCs")
	if npcsFolder then
		for _, npc in ipairs(npcsFolder:GetChildren()) do
			if npc:IsA("Model") and string.find(string.lower(npc.Name), "hazmat") and npc.PrimaryPart then
				local pos = npc:GetPivot().Position
				local d1 = (pos - Config.CenterPointRadar1.Position).Magnitude
				local d2 = (pos - Config.CenterPointRadar2.Position).Magnitude
				if d1 <= Config.RadarRadius1 or d2 <= Config.RadarRadius2 then
					local hazmatPP = workspace:FindFirstChild("Misc")
						and workspace.Misc:FindFirstChild("HazmatForm")
						and workspace.Misc.HazmatForm:FindFirstChild("PP")
					if isReady(hazmatPP) then return hazmatPP, "hazmat_form" end
				end
			end
		end
	end

	-- Scan special action prompts di seluruh workspace
	for _, desc in ipairs(workspace:GetDescendants()) do
		if desc:IsA("ProximityPrompt") and desc.Enabled then
			local actText = string.lower(desc.ActionText or "")
			for _, special in ipairs(specialActions) do
				if string.match(actText, special) then
					-- "take photo" hanya di-fire kalau gak ada NPC normal di antrian
					-- supaya gak konflik dengan step Camera normal di STEP_MAP
					if special == "take photo" and (normalNPCCount or 0) > 0 then
						logInfo("-> Skip take photo — ada NPC normal di antrian, handle via STEP_MAP")
					else
						if isReady(desc) then return desc, special end
					end
				end
			end
			local hireCost = string.match(desc.ActionText or "", "Hire.*%$(%d+)")
			if hireCost then
				local cost  = tonumber(hireCost)
				local money = getPlayerMoney()
				logInfo("💰 HIRE CHECK — cost: " .. tostring(cost) .. " | money: " .. tostring(money))
				if cost and money >= cost then
					if isReady(desc) then return desc, "hire_npc:" .. hireCost end
				else
					logInfo("💸 Skip hire — kurang duit, treat as anomaly")
					return desc, "hire_rejected"
				end
			end
		end
	end
	return nil, nil
end

-- ==========================================
-- MAIN LOOP
-- ==========================================
task.spawn(function()
	logInfo("Smart Cashier v33 AKTIF — Step-Aware Engine Online")

	local _firstTickDone = false

	while task.wait(0.5) do
		if _G.SmartCashier_ExecutionID ~= ExecutionID then break end

		-- Update radar visual
		pcall(function()
			updateVisualRadar("Radar1", Config.CenterPointRadar1.Position, Config.RadarRadius1, Color3.fromRGB(0, 255, 255), isRadarVisible)
			updateVisualRadar("Radar2", Config.CenterPointRadar2.Position, Config.RadarRadius2, Color3.fromRGB(0, 255, 100), isRadarVisible)
			updateVisualRadar("Radar3", Config.CenterPointRadar3.Position, Config.RadarRadius3, Color3.fromRGB(255, 255, 0), isRadarVisible)
			updateVisualRadar("Radar4", Config.CenterPointRadar4.Position, Config.RadarRadius4, Color3.fromRGB(255, 0, 0), isRadarVisible)
		end)

		local normalNPCs   = {}
		local anomalyNPCs  = {}
		local isStalkerActive = false

		-- Scan NPC + update status panel
		pcall(function()
			local npcsFolder = workspace:FindFirstChild("NPCs")
			local r1_status = "<font color='#aaaaaa'>Kosong</font>"
			local r2_status = "<font color='#aaaaaa'>Kosong</font>"
			local r4_status = "<font color='#aaaaaa'>Kosong</font>"

			if npcsFolder then
				for _, npc in ipairs(npcsFolder:GetChildren()) do
					if npc:IsA("Model") and npc.Name:lower() ~= "doctor" and npc.PrimaryPart then
					local isStalker = string.match(string.lower(npc.Name), "stalker") ~= nil
					if isStalker then
						isStalkerActive = true
					end

					-- StalkerMonster handle terpisah via isStalkerActive, skip dari radar normal
					if isStalker then continue end

					local npcPos = npc:GetPivot().Position
					local dist1  = (npcPos - Config.CenterPointRadar1.Position).Magnitude
					local dist2  = (npcPos - Config.CenterPointRadar2.Position).Magnitude
					local dist4  = (npcPos - Config.CenterPointRadar4.Position).Magnitude
					local isAnom = isAnomaly(npc)
					local statusText = isAnom
						and "<font color='#ff4444'>Anomali</font>"
						or  "<font color='#44ff44'>Normal</font>"

					if dist1 <= Config.RadarRadius1 then
						r1_status = statusText
						if isAnom then table.insert(anomalyNPCs, npc) else table.insert(normalNPCs, npc) end
					end
					if dist2 <= Config.RadarRadius2 then
						r2_status = statusText
						if isAnom then table.insert(anomalyNPCs, npc) else table.insert(normalNPCs, npc) end
					end
					if dist4 <= Config.RadarRadius4 then
						r4_status = "<font color='#ff4444'>Terdeteksi</font>"
					end
					end
				end
			end

			-- Update status labels
			StatusR1.Text = "R1 (CheckIn 1): " .. r1_status
			StatusR2.Text = "R2 (CheckIn 2): " .. r2_status
			StatusR4.Text = "R4 (Ask to Leave): " .. r4_status

			-- Update step display — poll CheckStepHighlight fresh tiap tick
			local activeStep, _ = getActiveCheckInStep()
			local activeNPCStep = getActiveStep6NPC()
			if activeStep then
				StatusStep.Text = "Step: <font color='#00ffff'>" .. activeStep.id .. "</font>"
			elseif activeNPCStep then
				StatusStep.Text = "Step: <font color='#ffff00'>Talk → " .. activeNPCStep .. "</font>"
			else
				StatusStep.Text = "Step: <font color='#aaaaaa'>-</font>"
			end
		end)

		if autoCashierEnabled then
			local ok, err = pcall(function()

				-- ── INIT — Teleport ke kasir saat pertama aktif ──────────────────
				if not _firstTickDone then
					_firstTickDone = true
					local char = LocalPlayer.Character
					local root = char and char:FindFirstChild("HumanoidRootPart")
					if root then
						logInfo("-> INIT: Teleport ke kasir")
						root.CFrame = Config.CashierCFrame
						root.Velocity = Vector3.new(0, 0, 0)
						task.wait(0.3)
					end
				end

				-- ── PRIORITAS 0 — Special Event & Stalker ───────────────────────
				local specialPrompt, specialType = getSpecialPrompt(isStalkerActive, #normalNPCs)

				if specialPrompt then
					if specialType == "inspect (stalker)" then
						logInfo("🚨 STALKER: inspect StrangePaper — retry loop aktif")
						local deadline = tick() + Config.StalkerTimeout
						local fired = false
						while tick() < deadline do
							if _G.SmartCashier_ExecutionID ~= ExecutionID then return end
							-- cek stalker masih ada
							local stillStalker = false
							local npcsFolder = workspace:FindFirstChild("NPCs")
							if npcsFolder then
								for _, npc in ipairs(npcsFolder:GetChildren()) do
									if npc:IsA("Model") and string.match(string.lower(npc.Name), "stalker") then
										stillStalker = true
										break
									end
								end
							end
							if not stillStalker then
								logInfo("✅ STALKER pergi — selesai")
								break
							end
							-- cari StrangePaper.PP fresh
							local sp = workspace:FindFirstChild("Misc")
								and workspace.Misc:FindFirstChild("StrangePaper")
								and workspace.Misc.StrangePaper:FindFirstChild("PP")
							if sp and sp.Enabled then
								logInfo("🚨 STALKER: fire StrangePaper.PP")
								teleportTo(Config.CashierCFrame, "Kasir (Stalker)")
								firePrompt(sp)
								task.wait(Config.StalkerClickDelay)
								autoClickScreen()
								task.wait(0.3)
								autoClickScreen() -- safety net klik kedua
								fired = true
							end
							task.wait(2.0) -- tunggu 2 detik sebelum retry
						end
						if not fired then
							logInfo("⚠️ STALKER timeout — give up")
						end
						return
					end

					if specialType == "take photo (stalker)" then
						logInfo("🚨 STALKER: take photo")
						teleportTo(Config.CashierCFrame, "Kasir (Stalker)")
						firePrompt(specialPrompt)
						actionCooldowns[specialPrompt] = tick() + 3.0
						return
					end

					if specialType == "give coffee" then
						if not hasItem("coffee") then
							local pp = getPromptByActionExact("coffee")
							if pp then
								teleportToPrompt(pp)
								firePrompt(pp)
								actionCooldowns[pp] = tick() + 2.5
							end
							return
						else
							equipItem("coffee")
						end
					elseif specialType == "give scalpel" then
						if not hasItem("scalpel") then
							local pp = getPromptByActionExact("scalpel")
							if pp then
								teleportToPrompt(pp)
								firePrompt(pp)
								actionCooldowns[pp] = tick() + 2.5
							end
							return
						else
							equipItem("scalpel")
						end
					end

				-- HIRE REJECTED — duit kurang, tutup shutter kalau gak ada NPC normal
				if specialType == "hire_rejected" then
					if #normalNPCs > 0 then
						logInfo("💸 HIRE REJECTED — tapi masih ada NPC normal, selesaikan dulu")
						return
					end
					logInfo("💸 HIRE REJECTED — duit kurang, tutup shutter")
					local shutterPP = workspace:FindFirstChild("Misc")
						and workspace.Misc:FindFirstChild("ShutterButton")
						and workspace.Misc.ShutterButton:FindFirstChild("PP")
					if shutterPP and shutterPP.ActionText == "Close" then
						teleportTo(Config.ShutterCFrame, "Shutter")
						firePrompt(shutterPP)
						actionCooldowns[shutterPP] = tick() + 3.0
					end
					return
				end

					if specialType == "hazmat_form" then
						logInfo("☢️ HAZMAT: fire form")
						teleportTo(Config.CashierCFrame, "Kasir (Hazmat)")
						firePrompt(specialPrompt)
						actionCooldowns[specialPrompt] = tick() + 2.5
						return
					end					

					logInfo("🌟 SPECIAL EVENT: " .. specialType)
					teleportToPrompt(specialPrompt)
					firePrompt(specialPrompt)
					actionCooldowns[specialPrompt] = tick() + 2.5
					return
				end

				-- Stalker aktif tapi belum ada prompt — standby
				if isStalkerActive then
					logInfo("⚠️ STALKER ACTIVE — standby kasir")
					teleportTo(Config.CashierCFrame, "Kasir (Standby Stalker)")
					return
				end

				-- ── PRIORITAS 1 — Normal NPC via Step-Aware Engine ──────────────
				local shutterPP = workspace:FindFirstChild("Misc")
					and workspace.Misc:FindFirstChild("ShutterButton")
					and workspace.Misc.ShutterButton:FindFirstChild("PP")

				if #normalNPCs > 0 then
					-- Buka shutter kalau masih tertutup
					if shutterPP and shutterPP.ActionText == "Open" then
						teleportTo(Config.ShutterCFrame, "Shutter")
						firePrompt(shutterPP)
						return
					end

					-- ── STEP-AWARE: cari step aktif via CheckStepHighlight ──────
					-- CheckStepHighlight dinamis — dicari fresh, bukan cached
					local activeStep, stepObj = getActiveCheckInStep()

					if activeStep then
						-- Step kasir aktif, fire promptnya
						local pp = getStepPP(stepObj)
						if pp and isReady(pp) then
							logInfo("-> STEP [" .. activeStep.id .. "] aktif → " .. activeStep.action)
							actionCooldowns[pp] = tick() + 2.5
							smartTeleportToCashier("Sebelum " .. activeStep.id)
							firePrompt(pp)
							return
						end
						-- PP belum ready (cooldown), tunggu sebentar
						logInfo("-> Step " .. activeStep.id .. " aktif tapi PP cooldown, skip tick ini")
						return
					end

					-- ── STEP 6 — NPC highlight aktif, cari talk prompt ──────────
					local activeNPCName = getActiveStep6NPC()
					if activeNPCName then
						local npcsFolder = workspace:FindFirstChild("NPCs")
						local targetNPC = npcsFolder and npcsFolder:FindFirstChild(activeNPCName)
						if targetNPC then
							-- Cari talk prompt langsung dari NPC yang highlight
							for _, desc in ipairs(targetNPC:GetDescendants()) do
								if desc:IsA("ProximityPrompt") and desc.Enabled
									and string.match(string.lower(desc.ActionText or ""), "talk") then
									if isReady(desc) then
										logInfo("-> STEP6 [" .. activeNPCName .. "] → Talk")
										actionCooldowns[desc] = tick() + 2.5
										smartTeleportToCashier("Sebelum Talk")
										task.wait(0.2)
										firePrompt(desc)
										return
									end
								end
							end
						end
					end

					-- ── FALLBACK — tidak ada step aktif, recovery posisi ─────────
					-- Kemungkinan jeda antar step (gap highlight hilang → highlight baru)
					-- Tunggu sebentar lalu recovery ke kasir supaya siap step berikutnya
					local char = LocalPlayer.Character
					local root = char and char:FindFirstChild("HumanoidRootPart")
					if root then
						local dist = (root.Position - Config.CashierCFrame.Position).Magnitude
						if dist > Config.RecoveryThreshold and hasActivePromptInRadar3() then
							logInfo("-> Tidak ada step aktif, recovery ke kasir")
							teleportTo(Config.CashierCFrame, "Kasir (Recovery)")
						end
					end
					return
				end

				-- ── PRIORITAS 2 — Anomaly ───────────────────────────────────────
				if #anomalyNPCs > 0 then
					if shutterPP and shutterPP.ActionText == "Close" then
						logInfo("-> ANOMALI! Tutup shutter")
						teleportTo(Config.ShutterCFrame, "Shutter")
						firePrompt(shutterPP)
						smartTeleportToCashier("Setelah tutup shutter (anomali)")
					else
						local char = LocalPlayer.Character
						local root = char and char:FindFirstChild("HumanoidRootPart")
						if root then
							local dist = (root.Position - Config.CashierCFrame.Position).Magnitude
							if dist > Config.RecoveryThreshold and hasActivePromptInRadar3() then
								teleportTo(Config.CashierCFrame, "Kasir (Anomali Recovery)")
							end
						end
					end
					return
				end

				-- ── PRIORITAS 3 — Idle, buka shutter kalau ada tamu baru ────────
				local checkIn1 = workspace:FindFirstChild("Misc") and workspace.Misc:FindFirstChild("CheckIn")
				local checkIn2 = workspace:FindFirstChild("Misc") and workspace.Misc:FindFirstChild("CheckIn2")
				local form1 = checkIn1 and checkIn1:FindFirstChild("Form")
				local form2 = checkIn2 and checkIn2:FindFirstChild("Form")

				if not form1 and not form2 and #normalNPCs == 0 and #anomalyNPCs == 0 then
					if shutterPP and shutterPP.ActionText == "Open" then
						logInfo("-> Idle, buka gerbang")
						teleportTo(Config.ShutterCFrame, "Shutter")
						firePrompt(shutterPP)
					end
				end

			end)

			if not ok then
				logInfo("⚠️ SYSTEM ERROR: " .. tostring(err))
			end
		end
	end
end)

