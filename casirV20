-- ==========================================

-- Map nama step → path object di Misc.CheckIn
-- Step6 (NPC talk) di-handle terpisah via NPCs folder
local STEP_MAP = {
	-- ── CheckIn 1 ─────────────────────────────────────────────────────────────
	{ id = "Form",          path = {"Misc", "CheckIn",  "Form"},         action = "Stamp Forms" },
	{ id = "Camera",        path = {"Misc", "CheckIn",  "Camera"},       action = "Take Photo"  },
	{ id = "Computer",      path = {"Misc", "CheckIn",  "Computer"},     action = "Register"    },
	{ id = "Printer",       path = {"Misc", "CheckIn",  "Printer"},      action = "Print Badge" },
	{ id = "PrintedBadge",  path = {"Misc", "CheckIn",  "PrintedBadge"}, action = "Take"        },

	-- ── CheckIn 2 (Computer & Printer shared ke CheckIn 1) ───────────────────
	{ id = "Form2",         path = {"Misc", "CheckIn2", "Form"},         action = "Stamp Forms" },
	{ id = "Camera2",       path = {"Misc", "CheckIn2", "Camera"},       action = "Take Photo"  },
	{ id = "Computer2",     path = {"Misc", "CheckIn",  "Computer"},     action = "Register"    }, -- shared
	{ id = "Printer2",      path = {"Misc", "CheckIn",  "Printer"},      action = "Print Badge" }, -- shared
	{ id = "PrintedBadge2", path = {"Misc", "CheckIn2", "PrintedBadge"}, action = "Take"        },
}

-- Resolves path table ke Instance — fresh tiap call (dynamic object)
local function resolvePath(pathTable)
	local cur = workspace
	for _, segment in ipairs(pathTable) do
		if not cur then return nil end
		cur = cur:FindFirstChild(segment)
	end
	return cur
end

-- Cek apakah step tertentu aktif via CheckStepHighlight
-- Harus fresh FindFirstChild — object ini spawn/destroy setiap state change
local function isStepActive(stepObj)
	if not stepObj then return false end
	return stepObj:FindFirstChild("CheckStepHighlight", true) ~= nil
end

-- Ambil PP dari object step — cari turunan langsung
local function getStepPP(stepObj)
	if not stepObj then return nil end

	-- Camera step — cari prompt "Take Photo" di ReplicatedStorage.Misc.Photo.PP
	if stepObj.Name == "Camera" then
		local rs = game:GetService("ReplicatedStorage")
		local photoPP = rs:FindFirstChild("Misc")
			and rs.Misc:FindFirstChild("Photo")
			and rs.Misc.Photo:FindFirstChild("PP")
		if photoPP and photoPP:IsA("ProximityPrompt") and photoPP.Enabled then
			if isReady(photoPP) then return photoPP end
		end
		return nil
	end

	-- Step lain — cari PP normal di dalam object
	local pp = stepObj:FindFirstChild("PP")
	if pp and pp:IsA("ProximityPrompt") and pp.Enabled then return pp end
	for _, d in ipairs(stepObj:GetDescendants()) do
		if d:IsA("ProximityPrompt") and d.Enabled then return d end
	end
	return nil
end

-- Tunggu step aktif dengan timeout
-- Return true kalau step aktif dalam timeout, false kalau timeout
local function waitForStep(stepObj, timeout)
	if not stepObj then return false end
	local deadline = tick() + (timeout or Config.StepWaitTimeout)
	while tick() < deadline do
		if _G.SmartCashier_ExecutionID ~= ExecutionID then return false end
		if isStepActive(stepObj) then return true end
		task.wait(Config.StepPollRate)
	end
	return false
end

-- Cari step mana yang aktif saat ini dari STEP_MAP
-- Return: { stepData, stepObj } atau nil kalau gak ada
local function getActiveCheckInStep()
	for _, step in ipairs(STEP_MAP) do
		local obj = resolvePath(step.path)
		if obj and isStepActive(obj) then
			return step, obj
		end
	end
	return nil, nil
end

-- Cari NPC yang Step6-nya aktif (highlight di NPCs folder)
-- Return: npcName string atau nil
local function getActiveStep6NPC()
	local npcsFolder = workspace:FindFirstChild("NPCs")
	if not npcsFolder then return nil end
	for _, npc in ipairs(npcsFolder:GetChildren()) do
		if npc:IsA("Model") and npc.Name:lower() ~= "doctor" then
			if npc:FindFirstChild("CheckStepHighlight", true) then
				return npc.Name
			end
		end
	end
	return nil
end

-- ==========================================
-- ANOMALY DETECTION
-- ==========================================
local function isAnomaly(npc)
	local lower = string.lower(npc.Name or "")
	if lower == "doctor" then return false end
	if string.find(lower, "monster") or string.find(lower, "ghost") then return true end
	local attr = npc:GetAttributes()
	if attr.Skinwalker or attr.SkinwalkerEasy or attr.PenaltyWhenLettingIn
		or attr.PhotoEffect == "CursedPhoto" or attr.PhotoEffect2 == "CursedPhoto" then
		return true
	end
	return false
end

local function getClosestCounter(npc)
	local checkIn1 = workspace:FindFirstChild("Misc") and workspace.Misc:FindFirstChild("CheckIn")
	local checkIn2 = workspace:FindFirstChild("Misc") and workspace.Misc:FindFirstChild("CheckIn2")
	local npcPos = npc:GetPivot().Position
	local d1 = (npcPos - Config.CenterPointRadar1.Position).Magnitude
	local d2 = (npcPos - Config.CenterPointRadar2.Position).Magnitude
	if d2 < d1 and checkIn2 then return checkIn2 else return checkIn1 end
end

local function hasItem(itemName)
	local char = LocalPlayer.Character
	local bp = LocalPlayer:FindFirstChild("Backpack")
	local function checkFolder(folder)
		if not folder then return false end
		for _, v in ipairs(folder:GetChildren()) do
			if v:IsA("Tool") and string.match(string.lower(v.Name), string.lower(itemName)) then
				return true
			end
		end
		return false
	end
	return checkFolder(char) or checkFolder(bp)
end

local function equipItem(itemName)
	local char = LocalPlayer.Character
	local hum = char and char:FindFirstChild("Humanoid")
	local bp = LocalPlayer:FindFirstChild("Backpack")
	if not hum or not bp then return end
	for _, v in ipairs(bp:GetChildren()) do
		if v:IsA("Tool") and string.match(string.lower(v.Name), string.lower(itemName)) then
			hum:EquipTool(v)
			task.wait(0.2)
			return
		end
	end
end

local function getPlayerMoney()
	local ok, result = pcall(function()
		local pg = LocalPlayer:FindFirstChild("PlayerGui")
		-- Path utama: Sanity.Frame.cash
		local sanity = pg and pg:FindFirstChild("Sanity")
		local frame = sanity and sanity:FindFirstChild("Frame")
		local cash = frame and frame:FindFirstChild("cash")
		if cash and cash:IsA("TextLabel") then
			local num = string.match(cash.Text, "%$(%d+)")
			if num then return tonumber(num) end
		end
		-- Fallback: scan seluruh PlayerGui
		if pg then
			for _, v in ipairs(pg:GetDescendants()) do
				if v:IsA("TextLabel") and v.Name == "cash" then
					local num = string.match(v.Text, "%$(%d+)")
					if num then return tonumber(num) end
				end
			end
		end
		return 0
	end)
	return ok and result or 0
end

local function getPromptByActionExact(actionName)
	for _, desc in ipairs(workspace:GetDescendants()) do
		if desc:IsA("ProximityPrompt") and desc.Enabled then
			if string.lower(desc.ActionText or "") == actionName then
				if isReady(desc) then return desc end
			end
		end
	end
	return nil
end

