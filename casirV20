local isNPCYapping = false

task.spawn(function()
	local rs  = game:GetService("ReplicatedStorage")
	local net = rs:WaitForChild("Util", 10) and rs.Util:WaitForChild("Net", 10)
	if not net then return end

	local displayBubble = net:WaitForChild("RE/DisplayBubble", 10)
	local playCutscene  = net:WaitForChild("RE/PlayCutscene", 10)

	local yappingTimer = nil
	if displayBubble then
		displayBubble.OnClientEvent:Connect(function()
			isNPCYapping = true
			if yappingTimer then task.cancel(yappingTimer) end
			yappingTimer = task.delay(4.0, function()
				isNPCYapping = false
				yappingTimer = nil
			end)
		end)
	end

	if playCutscene then
		playCutscene.OnClientEvent:Connect(function(cutsceneType)
			if cutsceneType == "VisitorCheckedIn" then
				-- NPC selesai check-in, yapping selesai
				isNPCYapping = false
			else
				isNPCYapping = true
				task.delay(6.0, function() isNPCYapping = false end)
			end
		end)
	end
end)

